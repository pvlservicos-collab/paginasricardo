# Copie as variáveis abaixo para a Vercel: Project → Settings → Environment Variables

# Obrigatórias para editar pelo painel (cada edição vira um commit e a Vercel publica sozinha)
GITHUB_TOKEN=github_pat_xxx          # token "fine-grained" só deste repositório, permissão Contents: Read and write
GITHUB_REPO=pvlservicos-collab/paginasricardo
GITHUB_BRANCH=main

# Segurança do login (troque por qualquer texto longo e aleatório)
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Opcional: trocar o login (padrão ricardo / 2026)
# PAINEL_USUARIO=ricardo
# PAINEL_SENHA=2026

# Métricas de visitas: crie um Upstash Redis em Storage na Vercel e ligue ao projeto.
# A Vercel preenche estas duas sozinha:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Leads por página (HubSpot → Settings → Integrations → Private Apps, escopo "forms")
# HUBSPOT_TOKEN=pat-na1-xxx

# Nota do Google PageSpeed sem limite de uso (console.cloud.google.com → PageSpeed Insights API)
# PAGESPEED_API_KEY=
